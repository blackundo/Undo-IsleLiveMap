<Window x:Class="TheIsleOverlay.App.ProKeyActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kích hoạt Isle Live Map Pro" Width="590" Height="500"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#071311" Foreground="#EAF4EF" FontFamily="Segoe UI"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border Margin="1" BorderBrush="#31544D" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="28,24" Background="#0B201D" BorderBrush="#29453F" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ISLE LIVE MAP" FontSize="11" FontWeight="Bold"
                                   Foreground="#72A99F" />
                        <TextBlock Text="KÍCH HOẠT PRO" Margin="0,5,0,0" FontSize="26"
                                   FontWeight="Bold" Foreground="#FFE2A0" />
                        <TextBlock Text="Key một lần · gắn với thiết bị này · Không cần đăng nhập Steam."
                                   Margin="0,6,0,0" Foreground="#A3B7B1" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="13,7" VerticalAlignment="Top"
                            Background="#18352F" BorderBrush="#397A6D" BorderThickness="1" CornerRadius="16">
                        <TextBlock Text="SECURE ACTIVATION" FontSize="10" FontWeight="Bold" Foreground="#71D9C5" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,24,28,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="KEY KÍCH HOẠT" FontSize="11" FontWeight="Bold" Foreground="#9DB2AC" />
                <Border Grid.Row="1" Margin="0,8,0,0" Background="#091A17"
                        BorderBrush="#41645C" BorderThickness="1" CornerRadius="7">
                    <TextBox x:Name="KeyInput" Padding="13,12" FontSize="16" MaxLength="128"
                             BorderThickness="0" Background="Transparent" Foreground="#F2FAF6"
                             CaretBrush="#FFE2A0" SelectionBrush="#4E8D7F"
                             AutomationProperties.Name="Key kích hoạt Pro" />
                </Border>
                <TextBlock Grid.Row="2" Margin="0,7,0,0" FontSize="11" Foreground="#78958D"
                           Text="Ứng dụng chỉ gửi key qua HTTPS. Lease được mã hóa bằng Windows DPAPI trên máy này." />

                <ProgressBar x:Name="ProgressIndicator" Grid.Row="3" Height="3" Margin="0,18,0,0"
                             IsIndeterminate="True" Visibility="Collapsed" Foreground="#E7B74E" />

                <Border x:Name="StatusPanel" Grid.Row="4" Margin="0,17,0,0" Padding="16,14"
                        VerticalAlignment="Top" Background="#102621" BorderBrush="#31544D"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusIcon" Text="i" FontSize="17" FontWeight="Bold"
                                   Foreground="#72CFC0" HorizontalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock x:Name="StatusTitle" Text="Sẵn sàng xác thực"
                                       FontWeight="SemiBold" Foreground="#E8F4EF" />
                            <TextBlock x:Name="StatusLabel" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="#9EB3AD"
                                       Text="Nhập key rồi bấm Kích hoạt. Quá trình có thể mất ít phút nếu cần tải Pro Agent." />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Padding="28,17" Background="#091A17"
                    BorderBrush="#29453F" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock VerticalAlignment="Center" Foreground="#718C85" FontSize="11"
                               Text="Key hợp lệ chỉ được kích hoạt trên một thiết bị." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CloseButton" Content="ĐÓNG" Margin="0,0,10,0"
                                Background="#172B27" Foreground="#C5D6D1" BorderBrush="#38554E"
                                Click="CloseButton_Click" />
                        <Button x:Name="ActivateButton" Content="KÍCH HOẠT" IsDefault="True"
                                Background="#E7B74E" Foreground="#171005" BorderBrush="#FFE09A"
                                Click="ActivateButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
