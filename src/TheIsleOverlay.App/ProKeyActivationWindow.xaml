<Window x:Class="TheIsleOverlay.App.ProKeyActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kích hoạt Isle Live Map Pro" Width="590" Height="500"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#EAEFF4" FontFamily="Segoe UI"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border Margin="1" Background="#070913" BorderBrush="#313854" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" MouseDown="TitleBar_MouseDown" Background="Transparent">
                <TextBlock Text="KÍCH HOẠT PRO" Foreground="#9EA4B3" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
                <Button Content="×" Width="27" Height="23" Padding="0" Margin="0,5,5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{DynamicResource ChromeButton}" Click="CloseButton_Click" />
            </Grid>

            <Border Grid.Row="1" Padding="28,24" Background="#0B0E20" BorderBrush="#292F45" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ISLE LIVE MAP" FontSize="11" FontWeight="Bold"
                                   Foreground="#727CA9" />
                        <TextBlock Text="KÍCH HOẠT PRO" Margin="0,5,0,0" FontSize="26"
                                   FontWeight="Bold" Foreground="#DDA0FF" />
                        <TextBlock Text="Key một lần · gắn với thiết bị này · Không cần đăng nhập Steam."
                                   Margin="0,6,0,0" Foreground="#A3A9B7" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="13,7" VerticalAlignment="Top"
                            Background="#181E35" BorderBrush="#39467A" BorderThickness="1" CornerRadius="16">
                        <TextBlock Text="SECURE ACTIVATION" FontSize="10" FontWeight="Bold" Foreground="#7185D9" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="28,24,28,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="KEY KÍCH HOẠT" FontSize="11" FontWeight="Bold" Foreground="#9DA3B2" />
                <Border Grid.Row="1" Margin="0,8,0,0" Background="#090C1A"
                        BorderBrush="#414964" BorderThickness="1" CornerRadius="7">
                    <TextBox x:Name="KeyInput" Padding="13,12" FontSize="16" MaxLength="128"
                             BorderThickness="0" Background="Transparent" Foreground="#F2F6FA"
                             CaretBrush="#DDA0FF" SelectionBrush="#4E5C8D"
                             AutomationProperties.Name="Key kích hoạt Pro" />
                </Border>
                <TextBlock Grid.Row="2" Margin="0,7,0,0" FontSize="11" Foreground="#788095"
                           Text="Ứng dụng chỉ gửi key qua HTTPS. Lease được mã hóa bằng Windows DPAPI trên máy này." />

                <ProgressBar x:Name="ProgressIndicator" Grid.Row="3" Height="3" Margin="0,18,0,0"
                             IsIndeterminate="True" Visibility="Collapsed" Foreground="#AF4EE7" />

                <Border x:Name="StatusPanel" Grid.Row="4" Margin="0,17,0,0" Padding="16,14"
                        VerticalAlignment="Top" Background="#101526" BorderBrush="#313854"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusIcon" Text="i" FontSize="17" FontWeight="Bold"
                                   Foreground="#7281CF" HorizontalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock x:Name="StatusTitle" Text="Sẵn sàng xác thực"
                                       FontWeight="SemiBold" Foreground="#E8EDF4" />
                            <TextBlock x:Name="StatusLabel" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="#9EA4B3"
                                       Text="Nhập key rồi bấm Kích hoạt. Quá trình có thể mất ít phút nếu cần tải Pro Agent." />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Padding="28,17" Background="#090C1A"
                    BorderBrush="#292F45" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock VerticalAlignment="Center" Foreground="#71788C" FontSize="11"
                               Text="Key hợp lệ chỉ được kích hoạt trên một thiết bị." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CloseButton" Content="ĐÓNG" Margin="0,0,10,0"
                                Background="#171B2B" Foreground="#C5CAD6" BorderBrush="#383F55"
                                Click="CloseButton_Click" />
                        <Button x:Name="ActivateButton" Content="KÍCH HOẠT" IsDefault="True"
                                Background="#AF4EE7" Foreground="#0F0517" BorderBrush="#DB9AFF"
                                Click="ActivateButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
