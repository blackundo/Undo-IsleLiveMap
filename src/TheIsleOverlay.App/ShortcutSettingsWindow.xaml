<Window x:Class="TheIsleOverlay.App.ShortcutSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phím tắt overlay"
        Width="590" Height="558"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12" Foreground="#DCEAE4"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ShortcutInput" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="146" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Foreground" Value="#F2F7F4" />
            <Setter Property="Background" Value="#D5091917" />
            <Setter Property="BorderBrush" Value="#4A6A62" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#37D4C6" />
            <Setter Property="SelectionBrush" Value="#6A37D4C6" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ShortcutButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B9CDC6" />
            <Setter Property="Background" Value="#D710211E" />
            <Setter Property="BorderBrush" Value="#46645D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border Margin="13" Background="#FA071716" BorderBrush="#7858736C"
            BorderThickness="1" CornerRadius="7">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="4" Opacity="0.8" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="62" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#34544E" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="17,0,11,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OVERLAY // INPUT" Foreground="#37D4C6"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="PHÍM TẮT OVERLAY" Foreground="#F0F7F3"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="30" Height="27" Content="×"
                            Style="{StaticResource ShortcutButton}" Padding="0"
                            AutomationProperties.Name="Đóng cài đặt phím tắt"
                            Click="CancelButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="158" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="CHỈNH BỐ CỤC · EDIT MODE" FontFamily="Bahnschrift SemiCondensed" FontWeight="SemiBold" />
                    <TextBlock Text="Vào/thoát chế độ di chuyển và resize block." Foreground="#78958D" FontSize="10" />
                </StackPanel>
                <TextBox x:Name="EditModeInput" Grid.Column="1" Style="{StaticResource ShortcutInput}"
                         PreviewKeyDown="ShortcutInput_PreviewKeyDown"
                         AutomationProperties.Name="Phím tắt chỉnh bố cục" />

                <StackPanel Grid.Row="1">
                    <TextBlock Text="ẨN / HIỆN TOÀN HUD" FontFamily="Bahnschrift SemiCondensed" FontWeight="SemiBold" />
                    <TextBlock Text="Không đổi Edit Mode hoặc lựa chọn block." Foreground="#78958D" FontSize="10" />
                </StackPanel>
                <TextBox x:Name="ToggleHudInput" Grid.Row="1" Grid.Column="1" Style="{StaticResource ShortcutInput}"
                         PreviewKeyDown="ShortcutInput_PreviewKeyDown"
                         AutomationProperties.Name="Phím tắt ẩn hiện toàn HUD" />

                <StackPanel Grid.Row="2">
                    <TextBlock Text="ẨN / HIỆN PRIME" FontFamily="Bahnschrift SemiCondensed" FontWeight="SemiBold" />
                    <TextBlock Text="Chỉ tác động danh sách nhiệm vụ Prime." Foreground="#78958D" FontSize="10" />
                </StackPanel>
                <TextBox x:Name="ToggleMissionsInput" Grid.Row="2" Grid.Column="1" Style="{StaticResource ShortcutInput}"
                         PreviewKeyDown="ShortcutInput_PreviewKeyDown"
                         AutomationProperties.Name="Phím tắt ẩn hiện Prime" />

                <StackPanel Grid.Row="3">
                    <TextBlock Text="MỞ BẢN ĐỒ MỐC" FontFamily="Bahnschrift SemiCondensed" FontWeight="SemiBold" />
                    <TextBlock Text="Mở map lớn để tạo, sửa hoặc xóa set point." Foreground="#78958D" FontSize="10" />
                </StackPanel>
                <TextBox x:Name="MapNotesInput" Grid.Row="3" Grid.Column="1" Style="{StaticResource ShortcutInput}"
                         PreviewKeyDown="ShortcutInput_PreviewKeyDown"
                         AutomationProperties.Name="Phím tắt bản đồ mốc" />

                <StackPanel Grid.Row="4">
                    <TextBlock Text="MỞ SỔ TAY MUTATION" FontFamily="Bahnschrift SemiCondensed" FontWeight="SemiBold" />
                    <TextBlock Text="Overlay đối chiếu 43 Mutation Anh–Việt." Foreground="#78958D" FontSize="10" />
                </StackPanel>
                <TextBox x:Name="MutationGuideInput" Grid.Row="4" Grid.Column="1" Style="{StaticResource ShortcutInput}"
                         PreviewKeyDown="ShortcutInput_PreviewKeyDown"
                         AutomationProperties.Name="Phím tắt sổ tay Mutation" />

                <TextBlock x:Name="FeedbackLabel" Grid.Row="5" Grid.ColumnSpan="2"
                           Text="Click ô rồi bấm tổ hợp mới. Mỗi tổ hợp cần Ctrl, Alt, Shift hoặc Win."
                           Foreground="#829D95" TextWrapping="Wrap" VerticalAlignment="Bottom" />
            </Grid>

            <Border Grid.Row="2" BorderBrush="#34544E" BorderThickness="0,1,0,0">
                <Grid Margin="17,0">
                    <Button Style="{StaticResource ShortcutButton}" Content="KHÔI PHỤC MẶC ĐỊNH"
                            HorizontalAlignment="Left" Click="DefaultsButton_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ShortcutButton}" Content="HỦY"
                                Margin="0,0,8,0" Click="CancelButton_Click" />
                        <Button Style="{StaticResource ShortcutButton}" Content="LƯU PHÍM TẮT"
                                Foreground="#10201D" Background="#F1C75B" BorderBrush="#FFE49A"
                                Click="SaveButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
