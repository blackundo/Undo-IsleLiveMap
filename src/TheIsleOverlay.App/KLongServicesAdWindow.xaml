<Window x:Class="TheIsleOverlay.App.KLongServicesAdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="KLong.dev" Width="960" Height="640"
        WindowStyle="None" ResizeMode="NoResize" Background="#050907"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="AdInk" Color="#050907" />
        <SolidColorBrush x:Key="AdBone" Color="#F0F4EC" />
        <SolidColorBrush x:Key="AdMuted" Color="#94A69F" />
        <SolidColorBrush x:Key="AdSubtle" Color="#647A72" />
        <SolidColorBrush x:Key="AdLine" Color="#29443C" />
        <SolidColorBrush x:Key="AdTeal" Color="#63E1CA" />
        <SolidColorBrush x:Key="AdGold" Color="#EAC25B" />

        <Style x:Key="AdPrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#171203" />
            <Setter Property="Background" Value="{StaticResource AdGold}" />
            <Setter Property="BorderBrush" Value="{StaticResource AdGold}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F6D777" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#CFA540" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#26302C" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#3A4B44" />
                                <Setter Property="Foreground" Value="#75877F" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AdQuietButton" TargetType="Button" BasedOn="{StaticResource AdPrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource AdBone}" />
            <Setter Property="Background" Value="#111F1B" />
            <Setter Property="BorderBrush" Value="{StaticResource AdLine}" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#49645B" BorderThickness="1" Background="{StaticResource AdInk}">
        <Grid x:Name="AdContent" Opacity="0">
            <Grid.RenderTransform><TranslateTransform x:Name="AdEntranceTransform" Y="10" /></Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="45" />
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource AdLine}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AdTeal}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="KLONG.DEV  /  DỊCH VỤ PHÁT TRIỂN"
                               Foreground="{StaticResource AdBone}" FontFamily="Bahnschrift" FontSize="10.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Grid.Column="2" Text="SPONSORED · 05s" Foreground="{StaticResource AdSubtle}"
                               FontFamily="Bahnschrift" FontSize="9.5" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="30,28,30,24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.92*" /><ColumnDefinition Width="34" /><ColumnDefinition Width="1.08*" /></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="HOÀNG KIM LONG" Foreground="{StaticResource AdGold}"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" />
                    <TextBlock Grid.Row="1" Text="BẠN CÓ Ý TƯỞNG.&#x0a;LONG BIẾN NÓ THÀNH&#x0a;SẢN PHẨM CHẠY ĐƯỢC."
                               Foreground="{StaticResource AdBone}" FontFamily="Bahnschrift SemiCondensed"
                               FontSize="31" FontWeight="Bold" LineHeight="33" Margin="0,12,0,0" />
                    <Border Grid.Row="2" Background="#18271F" BorderBrush="{StaticResource AdGold}" BorderThickness="1"
                            CornerRadius="3" Padding="11,9" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="NHẬN DỰ ÁN GAME &amp; WEB" Foreground="{StaticResource AdTeal}"
                                       FontFamily="Bahnschrift" FontSize="9.5" FontWeight="Bold" />
                            <TextBlock Text="Thiết kế website · mod game · tool/app · bot tự động"
                                       Foreground="{StaticResource AdGold}" FontFamily="Bahnschrift SemiCondensed"
                                       FontSize="16" FontWeight="Bold" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0" />
                            <TextBlock Text="Theo yêu cầu — từ ý tưởng đến sản phẩm chạy được."
                                       Foreground="{StaticResource AdMuted}" FontSize="10.5" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="3" VerticalAlignment="Center" Margin="0,16,0,10">
                        <TextBlock Text="ĐÃ ĐỒNG HÀNH CÙNG CÁC GAME BẠN ĐANG CHƠI" Foreground="{StaticResource AdSubtle}"
                                   FontFamily="Bahnschrift" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,9" />
                        <UniformGrid Columns="5">
                            <Border Height="67" Margin="0,0,5,0" Background="#111D1A" BorderBrush="{StaticResource AdLine}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
                                <Grid>
                                    <Image Source="Assets/Advertising/tft.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border VerticalAlignment="Bottom" Background="#C9000000" Padding="3,3"><TextBlock Text="TFT" Foreground="{StaticResource AdBone}" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                </Grid>
                            </Border>
                            <Border Height="67" Margin="0,0,5,0" Background="#111D1A" BorderBrush="{StaticResource AdLine}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
                                <Grid>
                                    <Image Source="Assets/Advertising/fco4.jpg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border VerticalAlignment="Bottom" Background="#C9000000" Padding="3,3"><TextBlock Text="FC 4" Foreground="{StaticResource AdBone}" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                </Grid>
                            </Border>
                            <Border Height="67" Margin="0,0,5,0" Background="#111D1A" BorderBrush="{StaticResource AdLine}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
                                <Grid>
                                    <Image Source="Assets/Advertising/nro.jpg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border VerticalAlignment="Bottom" Background="#C9000000" Padding="3,3"><TextBlock Text="NRO" Foreground="{StaticResource AdBone}" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                </Grid>
                            </Border>
                            <Border Height="67" Margin="0,0,5,0" Background="#111D1A" BorderBrush="{StaticResource AdLine}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
                                <Grid>
                                    <Image Source="Assets/Advertising/hso.jpg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border VerticalAlignment="Bottom" Background="#C9000000" Padding="3,3"><TextBlock Text="HSO" Foreground="{StaticResource AdBone}" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                </Grid>
                            </Border>
                            <Border Height="67" Background="#111D1A" BorderBrush="{StaticResource AdLine}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
                                <Grid>
                                    <Image Source="Assets/Advertising/vltn.webp" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border VerticalAlignment="Bottom" Background="#C9000000" Padding="3,3"><TextBlock Text="VLTN" Foreground="{StaticResource AdBone}" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                    <StackPanel Grid.Row="4">
                        <Button Style="{StaticResource AdPrimaryButton}" Content="TRAO ĐỔI QUA FACEBOOK  ↗"
                                HorizontalAlignment="Stretch" Click="FacebookButton_Click" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="ZALO / PHONE" Foreground="{StaticResource AdSubtle}" FontFamily="Bahnschrift" FontSize="9.5" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource AdQuietButton}" Content="0705 878 781  ·  SAO CHÉP"
                                    Padding="12,7" FontSize="10.5" Click="CopyPhoneButton_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="XEM CÁCH LONG BIẾN Ý TƯỞNG THÀNH SẢN PHẨM"
                               Foreground="{StaticResource AdBone}" FontFamily="Bahnschrift SemiCondensed"
                               FontSize="13" FontWeight="Bold" Margin="0,0,0,10" />
                    <Border Grid.Row="1" Background="#020403" BorderBrush="#38564D" BorderThickness="1">
                        <Grid>
                            <StackPanel x:Name="VideoFallbackPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                <TextBlock Text="VIDEO SHOWCASE" Foreground="{StaticResource AdGold}"
                                           FontFamily="Bahnschrift SemiCondensed" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="VideoFallbackDetail" Text="Đang chuẩn bị video…"
                                           Foreground="{StaticResource AdMuted}" FontSize="11" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,8,0,16" />
                                <Button Style="{StaticResource AdQuietButton}" Content="MỞ TRÊN YOUTUBE  ↗" Click="YouTubeButton_Click" />
                            </StackPanel>
                            <wv2:WebView2 x:Name="VideoBrowser" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Không tự phát âm thanh · Video tải khi cửa sổ mở" Foreground="{StaticResource AdSubtle}" FontSize="9.5" />
                        <TextBlock Grid.Column="1" Text="YOUTUBE" Foreground="{StaticResource AdTeal}" FontFamily="Bahnschrift" FontSize="9.5" FontWeight="Bold" />
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource AdLine}" BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CountdownLabel" Text="CÓ THỂ ĐÓNG SAU 5 GIÂY" Foreground="{StaticResource AdMuted}"
                                   FontFamily="Bahnschrift" FontSize="10" FontWeight="SemiBold" />
                        <ProgressBar x:Name="CountdownProgress" Minimum="0" Maximum="100" Value="0" Height="3" Margin="0,8,0,0"
                                     Foreground="{StaticResource AdTeal}" Background="#16241F" BorderThickness="0" />
                    </StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource AdPrimaryButton}"
                            Content="ĐÓNG SAU 5 GIÂY" MinWidth="154" IsEnabled="False" Click="CloseButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
