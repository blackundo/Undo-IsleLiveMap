<Window x:Class="TheIsleOverlay.App.ReleaseHighlightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Có gì mới trong Isle Live Map"
        Width="1000" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Foreground="#939BA7"
        TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Bone" Color="#F2F4EC" />
        <SolidColorBrush x:Key="Muted" Color="#9198A4" />
        <SolidColorBrush x:Key="Mint" Color="#8FA2E3" />
        <SolidColorBrush x:Key="Gold" Color="#C05BF1" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#120416" />
            <Setter Property="Background" Value="#C05BF1" />
            <Setter Property="BorderBrush" Value="#DF9AFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DB84FF" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#A03ED6" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FFFFFF" /><Setter Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#C9CED6" />
            <Setter Property="Background" Value="#10141F" />
            <Setter Property="BorderBrush" Value="#3C455B" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#9198A4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FreeTag" TargetType="Border">
            <Setter Property="Background" Value="#151B2A" />
            <Setter Property="BorderBrush" Value="#4B5981" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="ProTag" TargetType="Border" BasedOn="{StaticResource FreeTag}">
            <Setter Property="Background" Value="#291333" />
            <Setter Property="BorderBrush" Value="#753D8E" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="BorderBrush" Value="#363E56" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#0D1221" />
            <Setter Property="Padding" Value="17" />
        </Style>
        <Style x:Key="ProPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="BorderBrush" Value="#6C3A81" />
            <Setter Property="Background" Value="#1E0E24" />
        </Style>
        <Style x:Key="CaptureFrame" TargetType="Border">
            <Setter Property="Background" Value="#070A14" />
            <Setter Property="BorderBrush" Value="#4B5981" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style x:Key="FeatureLine" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C5CAD2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>
    </Window.Resources>

    <Border Margin="14" Background="#FD070A14" BorderBrush="#685D6371" BorderThickness="1" CornerRadius="7">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="6" Opacity="0.86" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="68" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="218" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2" BorderBrush="#313850" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="17,0,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Width="18" Height="18"><Ellipse Width="16" Height="16" Stroke="#C05BF1" StrokeThickness="1" /><Ellipse Width="5" Height="5" Fill="#8FA2E3" /></Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="FIELD UPDATE // 12 BRIEFINGS" Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock x:Name="TitleVersionLabel" Text="   ISLE LIVE MAP · v2.0.0" Foreground="#71788A" FontFamily="Bahnschrift" FontSize="9.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource QuietButton}" Content="×" Width="30" Height="26" FontSize="16" AutomationProperties.Name="Đóng; lần sau vẫn hiện" Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.RowSpan="2" Background="#0B0F1B" BorderBrush="#313850" BorderThickness="0,0,1,0">
                <Grid Margin="20,20,18,21">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="WHAT'S NEW" Foreground="{StaticResource Gold}" FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="FIELD BRIEFING" Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="23" FontWeight="Bold" Margin="0,3,0,0" />
                        <TextBlock Text="Đi hết 12 mục để xem đầy đủ thay đổi đến bản 2.2.2." Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,6,0,0" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <StackPanel>
                            <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepIntroMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="1" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="ORIGIN + GACHA" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Chọn nguồn dưới nút Mở Map" Foreground="#656D7E" FontSize="9.5" /></StackPanel></Grid>
                            <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepOneMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="2" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="STATS ĐA NGUỒN" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="IslePilot · Gacha chính thức" Foreground="#656D7E" FontSize="9.5" /></StackPanel></Grid>
                            <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepTwoMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="3" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="VIỆT HÓA + MUTATION" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="English · Tiếng Việt · Alt+U" Foreground="#656D7E" FontSize="9.5" /></StackPanel></Grid>
                            <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepThreeMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="4" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="MỐC TỌA ĐỘ DỄ XÓA" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Alt+M · XYZ · Delete" Foreground="#656D7E" FontSize="9.5" /></StackPanel></Grid>
                            <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepFourMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="5" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="PHÍM TẮT + BLOCK RIÊNG" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Ctrl+Shift+O · Alt+P · lưu nhớ" Foreground="#656D7E" FontSize="9.5" /></StackPanel></Grid>
                            <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepFiveMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="6" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="SKIN EDITOR + GARAGE" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Pro · Alt+S · Alt+G" Foreground="#656D7E" FontSize="9.5" /></StackPanel></Grid>
                            <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepSixMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="7" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="FREE / PRO RÕ RÀNG" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Quyền theo SteamID64" Foreground="#656D7E" FontSize="9.5" /></StackPanel></Grid>
                            <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepLayersMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="8" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="LỚP BẢN ĐỒ OFFLINE" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Zone · đường · nước · tài nguyên" Foreground="#656D7E" FontSize="9.5" /></StackPanel></Grid>
                            <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepNotesMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="9" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="ALT + M / MỐC" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Click · XYZ · 4 cách xóa" Foreground="#656D7E" FontSize="9.5" /></StackPanel></Grid>
                            <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepTeamMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="10" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="NHÓM SINH TỒN" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Snapshot · reconnect · TTL" Foreground="#656D7E" FontSize="9.5" /></StackPanel></Grid>
                            <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepHudMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="11" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="MINIMAP GỌN HƠN" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Chỉ giữ thông tin cần thiết" Foreground="#656D7E" FontSize="9.5" /></StackPanel></Grid>
                            <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepSummaryMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="12" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="TỔNG KẾT 2.2.2" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Free / Pro · tự ghi nhớ" Foreground="#656D7E" FontSize="9.5" /></StackPanel></Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="3">
                        <Border Style="{StaticResource FreeTag}"><TextBlock Text="FREE · CHO MỌI USER" Foreground="#8FA2E3" FontFamily="Bahnschrift" FontSize="8.5" FontWeight="Bold" /></Border>
                        <Border Style="{StaticResource ProTag}" Margin="0,7,0,0"><TextBlock Text="PRO · CẦN PRO ACCESS" Foreground="#DB8AFF" FontFamily="Bahnschrift" FontSize="8.5" FontWeight="Bold" /></Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ReleaseContent" Grid.Row="1" Grid.Column="1" Margin="28,24,28,18" Opacity="0">
                <Grid.RenderTransform><TranslateTransform x:Name="ReleaseEntranceTransform" Y="10" /></Grid.RenderTransform>

                <Grid x:Name="PageIntro">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource FreeTag}"><TextBlock Text="FREE · 2.0.2" Foreground="#8FA2E3" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border>
                        <TextBlock Text="THÊM NGUỒN SERVER ORIGIN VÀ GACHA" Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="28" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Chọn nguồn phía dưới nút Mở Map để dùng đúng luồng stats của server." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,24,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" Background="#070C16" BorderBrush="#4B5981" BorderThickness="1" CornerRadius="4" Padding="6" VerticalAlignment="Top">
                                    <Image Source="Assets/GachaLogo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                    <TextBlock Text="GACHA" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="Bold" />
                                    <TextBlock Text="Stats chính thức · server Gacha" Foreground="#A9AFBA" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="Chọn GACHA bên dưới nút Mở Map" Foreground="#8FA2E3" FontFamily="Bahnschrift" FontSize="9.5" FontWeight="Bold" Margin="0,9,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" Background="#070C16" BorderBrush="#4B5981" BorderThickness="1" CornerRadius="4" Padding="6" VerticalAlignment="Top">
                                    <Image Source="Assets/OriginLogo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                    <TextBlock Text="ORIGIN x5" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="Bold" />
                                    <TextBlock Text="Main Origin · Voice Chat Server" Foreground="#A9AFBA" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="Chọn ORIGIN bên dưới nút Mở Map" Foreground="#8FA2E3" FontFamily="Bahnschrift" FontSize="9.5" FontWeight="Bold" Margin="0,9,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="14"><TextBlock Text="IslePilot vẫn là nguồn mặc định. Live Map sẽ tự chuyển sang nguồn bạn đã chọn và giữ GPS hoạt động trên mọi server." Foreground="#B4BBC5" FontSize="10.5" TextWrapping="Wrap" /></Border>
                </Grid>

                <Grid x:Name="PageOne">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource FreeTag}"><TextBlock Text="FREE · 2.0.0" Foreground="#8FA2E3" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border>
                        <TextBlock Text="DINO STATS ĐÚNG NGUỒN HƠN." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="Bold" Margin="0,10,0,0" />
                        <TextBlock Text="Stats cá nhân lấy từ IslePilot; server Gacha có luồng chính thức riêng, không làm ảnh hưởng GPS." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,30,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}" Padding="15"><StackPanel><TextBlock Text="01" Foreground="#8FA2E3" FontFamily="Bahnschrift" FontSize="10" FontWeight="Bold" /><TextBlock Text="ISLEPILOT" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" Margin="0,7,0,0" /><TextBlock Text="GPS + stats cá nhân" Foreground="#A9AFBA" FontSize="10" Margin="0,4,0,0" /></StackPanel></Border>
                        <TextBlock Grid.Column="1" Text="→" Foreground="#8FA2E3" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="15"><StackPanel><TextBlock Text="02" Foreground="#8FA2E3" FontFamily="Bahnschrift" FontSize="10" FontWeight="Bold" /><TextBlock Text="GACHA" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" Margin="0,7,0,0" /><TextBlock Text="API + WebSocket chính thức" Foreground="#A9AFBA" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                        <TextBlock Grid.Column="3" Text="→" Foreground="#8FA2E3" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Grid.Column="4" Style="{StaticResource Panel}" Padding="15"><StackPanel><TextBlock Text="03" Foreground="#8FA2E3" FontFamily="Bahnschrift" FontSize="10" FontWeight="Bold" /><TextBlock Text="STATE BỀN" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" Margin="0,7,0,0" /><TextBlock Text="Giữ stats qua heartbeat thưa" Foreground="#A9AFBA" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="14"><TextBlock Text="Bấm GACHA STATS trên Home để đăng nhập nguồn chính thức. Nếu chưa có nguồn, Live Map vẫn mở GPS bình thường." Foreground="#B4BBC5" FontSize="10.5" TextWrapping="Wrap" /></Border>
                </Grid>

                <Grid x:Name="PageTwo" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource FreeTag}"><TextBlock Text="FREE · 2.0.0" Foreground="#8FA2E3" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border>
                        <TextBlock Text="VIỆT HÓA GAME, CÓ SỔ TAY MUTATION." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Chọn English hoặc Tiếng Việt trên Home; mở sổ tay 43 Mutation bằng phím tắt, không inject vào game." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="TIẾNG VIỆT" Foreground="#8FA2E3" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" /><TextBlock Text="Resource được xác minh checksum trước khi cài. Tắt game để đổi locale an toàn." Foreground="#A9AFBA" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="43 MUTATION" Foreground="#8FA2E3" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" /><TextBlock Text="Sổ tay tra cứu tên và mô tả Việt hóa, mở bằng ALT + U ngay trong Live Map." Foreground="#A9AFBA" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Grid.Row="2" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="KHÔNG INJECT" Foreground="#8FA2E3" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" /><TextBlock Text="Overlay tách riêng khỏi game; không đọc memory và không sửa native Mutation runtime." Foreground="#A9AFBA" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
