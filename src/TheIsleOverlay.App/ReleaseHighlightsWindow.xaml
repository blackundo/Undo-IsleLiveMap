<Window x:Class="TheIsleOverlay.App.ReleaseHighlightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Có gì mới trong Isle Live Map"
        Width="1000" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Foreground="#93A79F"
        TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Bone" Color="#F2F4EC" />
        <SolidColorBrush x:Key="Muted" Color="#91A49D" />
        <SolidColorBrush x:Key="Mint" Color="#8FE3D0" />
        <SolidColorBrush x:Key="Gold" Color="#F1C75B" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#161304" />
            <Setter Property="Background" Value="#F1C75B" />
            <Setter Property="BorderBrush" Value="#FFE49A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#FFE184" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#D6A83E" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FFFFFF" /><Setter Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#C9D6D1" />
            <Setter Property="Background" Value="#101F1B" />
            <Setter Property="BorderBrush" Value="#3C5B52" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#91A49D" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FreeTag" TargetType="Border">
            <Setter Property="Background" Value="#152A24" />
            <Setter Property="BorderBrush" Value="#4B8173" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="ProTag" TargetType="Border" BasedOn="{StaticResource FreeTag}">
            <Setter Property="Background" Value="#332B13" />
            <Setter Property="BorderBrush" Value="#8E793D" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="BorderBrush" Value="#36564E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#0D211C" />
            <Setter Property="Padding" Value="17" />
        </Style>
        <Style x:Key="ProPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="BorderBrush" Value="#81703A" />
            <Setter Property="Background" Value="#241F0E" />
        </Style>
    </Window.Resources>

    <Border Margin="14" Background="#FD071411" BorderBrush="#685D716B" BorderThickness="1" CornerRadius="7">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="6" Opacity="0.86" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="68" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="218" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2" BorderBrush="#315049" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="17,0,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Width="18" Height="18"><Ellipse Width="16" Height="16" Stroke="#F1C75B" StrokeThickness="1" /><Ellipse Width="5" Height="5" Fill="#8FE3D0" /></Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="FIELD UPDATE // 05 BRIEFINGS" Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock x:Name="TitleVersionLabel" Text="   ISLE LIVE MAP · v2.0.0" Foreground="#718A83" FontFamily="Bahnschrift" FontSize="9.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource QuietButton}" Content="×" Width="30" Height="26" FontSize="16" AutomationProperties.Name="Đóng; lần sau vẫn hiện" Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.RowSpan="2" Background="#0B1B17" BorderBrush="#315049" BorderThickness="0,0,1,0">
                <Grid Margin="20,20,18,21">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="WHAT'S NEW" Foreground="{StaticResource Gold}" FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="FIELD BRIEFING" Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="23" FontWeight="Bold" Margin="0,3,0,0" />
                        <TextBlock Text="Đi hết 5 mục để xem đủ thay đổi của bản 2.0.0." Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,22,0,0">
                        <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepOneMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="1" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="STATS ĐA NGUỒN" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="IslePilot · Gacha chính thức" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                        <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepTwoMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="2" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="VIỆT HÓA + MUTATION" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="English · Tiếng Việt · Alt+U" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                        <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepThreeMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="3" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="MỐC TỌA ĐỘ DỄ XÓA" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Alt+M · XYZ · Delete" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                        <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepFourMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="4" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="PHÍM TẮT + BLOCK RIÊNG" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Ctrl+Shift+O · Alt+P · lưu nhớ" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                        <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepFiveMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="5" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="FREE / PRO RÕ RÀNG" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Quyền theo SteamID64" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="3">
                        <Border Style="{StaticResource FreeTag}"><TextBlock Text="FREE · CHO MỌI USER" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="8.5" FontWeight="Bold" /></Border>
                        <Border Style="{StaticResource ProTag}" Margin="0,7,0,0"><TextBlock Text="PRO · CẦN PRO ACCESS" Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="8.5" FontWeight="Bold" /></Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ReleaseContent" Grid.Row="1" Grid.Column="1" Margin="28,24,28,18" Opacity="0">
                <Grid.RenderTransform><TranslateTransform x:Name="ReleaseEntranceTransform" Y="10" /></Grid.RenderTransform>

                <Grid x:Name="PageOne">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource FreeTag}"><TextBlock Text="FREE · 2.0.0" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border>
                        <TextBlock Text="DINO STATS ĐÚNG NGUỒN HƠN." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="Bold" Margin="0,10,0,0" />
                        <TextBlock Text="Stats cá nhân lấy từ IslePilot; server Gacha có luồng chính thức riêng, không làm ảnh hưởng GPS." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,30,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}" Padding="15"><StackPanel><TextBlock Text="01" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="10" FontWeight="Bold" /><TextBlock Text="ISLEPILOT" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" Margin="0,7,0,0" /><TextBlock Text="GPS + stats cá nhân" Foreground="#A9BAB4" FontSize="10" Margin="0,4,0,0" /></StackPanel></Border>
                        <TextBlock Grid.Column="1" Text="→" Foreground="#8FE3D0" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="15"><StackPanel><TextBlock Text="02" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="10" FontWeight="Bold" /><TextBlock Text="GACHA" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" Margin="0,7,0,0" /><TextBlock Text="API + WebSocket chính thức" Foreground="#A9BAB4" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                        <TextBlock Grid.Column="3" Text="→" Foreground="#8FE3D0" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Grid.Column="4" Style="{StaticResource Panel}" Padding="15"><StackPanel><TextBlock Text="03" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="10" FontWeight="Bold" /><TextBlock Text="STATE BỀN" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" Margin="0,7,0,0" /><TextBlock Text="Giữ stats qua heartbeat thưa" Foreground="#A9BAB4" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="14"><TextBlock Text="Bấm GACHA STATS trên Home để đăng nhập nguồn chính thức. Nếu chưa có nguồn, Live Map vẫn mở GPS bình thường." Foreground="#B4C5BE" FontSize="10.5" TextWrapping="Wrap" /></Border>
                </Grid>

                <Grid x:Name="PageTwo" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource FreeTag}"><TextBlock Text="FREE · 2.0.0" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border>
                        <TextBlock Text="VIỆT HÓA GAME, CÓ SỔ TAY MUTATION." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Chọn English hoặc Tiếng Việt trên Home; mở sổ tay 43 Mutation bằng phím tắt, không inject vào game." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="TIẾNG VIỆT" Foreground="#8FE3D0" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" /><TextBlock Text="Resource được xác minh checksum trước khi cài. Tắt game để đổi locale an toàn." Foreground="#A9BAB4" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="43 MUTATION" Foreground="#8FE3D0" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" /><TextBlock Text="Sổ tay tra cứu tên và mô tả Việt hóa, mở bằng ALT + U ngay trong Live Map." Foreground="#A9BAB4" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Grid.Row="2" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="KHÔNG INJECT" Foreground="#8FE3D0" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" /><TextBlock Text="Overlay tách riêng khỏi game; không đọc memory và không sửa native Mutation runtime." Foreground="#A9BAB4" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="REBRAND" Foreground="#F1C75B" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" /><TextBlock Text="Credit hiển thị Phát triển bởi Isle Live Map trong resource Việt hóa." Foreground="#B4AA86" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Sổ tay Mutation là lớp hỗ trợ tra cứu; native UI của game vẫn giữ nguyên." Foreground="#718A83" FontFamily="Bahnschrift" FontSize="9.5" Margin="0,15,0,0" TextWrapping="Wrap" />
                </Grid>

                <Grid x:Name="PageThree" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource ProTag}"><TextBlock Text="PRO · 2.0.0" Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border>
                        <TextBlock Text="ĐẶT MỐC, NHẬP XYZ, XÓA NGAY." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="30" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Alt + M mở bản đồ lớn; click mốc cũ để đổi icon hoặc chọn thùng rác để xóa đúng mốc của bạn." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.12*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="0.88*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#4B8173" BorderThickness="1" Background="#071611" Padding="8" ClipToBounds="True">
                            <Image Source="Assets/SetPointTip.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="ALT + M" Foreground="#F1C75B" FontFamily="Bahnschrift" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="MỞ MAP LỚN" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="17" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock Text="Click để đặt mốc. Nhập X, Y, Z theo format của game rồi bấm ĐẶT MỐC." Foreground="#A9BAB4" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,18" />
                            <TextBlock Text="CLICK MỐC CŨ" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="Icon thùng rác xuất hiện trong bảng icon. Phím Delete cũng xóa mốc local đang chọn." Foreground="#A9BAB4" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource ProPanel}" Padding="14"><TextBlock Text="Mốc của đồng đội vẫn được phân biệt quyền sở hữu; bạn chỉ xóa được mốc do mình tạo." Foreground="#D0C495" FontSize="10.5" TextWrapping="Wrap" /></Border>
                </Grid>

                <Grid x:Name="PageFour" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource FreeTag}"><TextBlock Text="FREE · 2.0.0" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border>
                        <TextBlock Text="PHÍM TẮT RÕ RÀNG, BLOCK TỰ CHỦ." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="30" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Đổi phím ngay trong Home hoặc Edit Mode; từng block có thể bật/tắt và cấu hình được lưu cho lần mở sau." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Background="#091A16">
                            <Border BorderBrush="#8FE3D0" BorderThickness="1" Margin="12,12,175,118"><Grid><TextBlock Text="MAP  ·  BẬT" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="10" Margin="10" /><TextBlock Text="↘" Foreground="#F1C75B" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Grid></Border>
                            <Border BorderBrush="#526E65" BorderThickness="1" Margin="212,12,12,176"><Grid><TextBlock Text="STATUS  ·  BẬT" Foreground="#C8D4CF" FontFamily="Bahnschrift" FontSize="9" Margin="9" /><TextBlock Text="↘" Foreground="#F1C75B" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Grid></Border>
                            <Border BorderBrush="#526E65" BorderThickness="1" Margin="212,108,12,82"><Grid><TextBlock Text="TEAM  ·  TẮT" Foreground="#C8D4CF" FontFamily="Bahnschrift" FontSize="9" Margin="9" /><TextBlock Text="↘" Foreground="#F1C75B" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Grid></Border>
                            <Border BorderBrush="#526E65" BorderThickness="1" Margin="94,207,12,12"><Grid><TextBlock Text="PRIME  ·  BẬT" Foreground="#C8D4CF" FontFamily="Bahnschrift" FontSize="9" Margin="9" /><TextBlock Text="↘" Foreground="#F1C75B" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Grid></Border>
                        </Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="CTRL + SHIFT + O" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="11" />
                            <TextBlock Text="MỞ EDIT MODE" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontWeight="Bold" FontSize="14" Margin="0,5,0,0" />
                            <TextBlock Text="Kéo để đổi vị trí hoặc resize riêng Map, Status, Team và Prime." Foreground="#91A49D" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,14" />
                            <TextBlock Text="BẬT / TẮT TỪNG BLOCK" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontWeight="Bold" FontSize="14" />
                            <TextBlock Text="Ẩn Team hoặc Prime mà không ảnh hưởng các block còn lại." Foreground="#91A49D" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,14" />
                            <TextBlock Text="ALT + P  ·  ẨN / HIỆN HUD" Foreground="#F1C75B" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10.5" />
                            <TextBlock Text="Cài đặt phím tắt có kiểm tra xung đột; layout và trạng thái block tự động được ghi nhớ." Foreground="#B4AA86" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Cần làm mới giao diện? Dùng Đặt lại layout để khôi phục mặc định bất kỳ lúc nào." Foreground="#718A83" FontSize="10" Margin="0,15,0,0" TextWrapping="Wrap" />
                </Grid>

                <Grid x:Name="PageFive" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource FreeTag}"><TextBlock Text="ACCESS SUMMARY · v2.0.0" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border>
                        <TextBlock Text="FREE LÀ NỀN TẢNG. PRO THÊM CHIỀU SÂU." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="28" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap" />
