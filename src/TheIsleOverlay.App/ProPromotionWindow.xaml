<Window x:Class="TheIsleOverlay.App.ProPromotionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kích hoạt Isle Live Map Pro"
        Width="920" Height="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Bone" Color="#F1E8F3" />
        <SolidColorBrush x:Key="Muted" Color="#9CA9AC" />
        <SolidColorBrush x:Key="Gold" Color="#C05BF1" />
        <SolidColorBrush x:Key="Mint" Color="#7689D7" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#110417" />
            <Setter Property="Background" Value="#C05BF1" />
            <Setter Property="BorderBrush" Value="#E19AFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DB84FF" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#A13ED5" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FFFFFF" /><Setter Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#9CA9AC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#F1E8F3" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#23283A" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" Background="#FC070A14" BorderBrush="#6D5D6471" BorderThickness="1" CornerRadius="7">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="6" Opacity="0.86" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Border BorderBrush="#313850" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="17,0,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Width="18" Height="18"><Ellipse Width="16" Height="16" Stroke="#C05BF1" StrokeThickness="1" /><Ellipse Width="5" Height="5" Fill="#7689D7" /></Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="FIELD INTELLIGENCE // PRO" Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock Text="   FREE KEY ACCESS" Foreground="#71788A" FontFamily="Bahnschrift" FontSize="9.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource QuietButton}" Content="×" Width="30" Height="26" Padding="0" FontSize="16" AutomationProperties.Name="Đóng thông báo Pro" Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Grid x:Name="PromotionContent" Grid.Row="1" Margin="25,24,25,25" Opacity="0">
                <Grid.RenderTransform><TranslateTransform x:Name="PromotionEntranceTransform" Y="10" /></Grid.RenderTransform>
                <Grid.ColumnDefinitions><ColumnDefinition Width="430" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <Border Margin="0,0,24,0" Background="#0A0D20" BorderBrush="#555D71" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                    <Grid>
                        <Image Source="Assets/ProMapPreview.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Minimap Pro hiển thị player và AI" />
                        <Rectangle Fill="#24000000" IsHitTestVisible="False" />
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#E0080A1B" BorderBrush="#52596F" BorderThickness="0,0,1,1" Padding="10,7">
                            <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#7689D7" Margin="0,0,7,0" /><TextBlock Text="LIVE SIGNAL · ALL SERVERS" Foreground="#EAEFF6" FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border VerticalAlignment="Bottom" Background="#E6070A14" BorderBrush="#562D66" BorderThickness="0,1,0,0" Padding="15,13">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="DỮ LIỆU TRONG TẦM NHÌN" Foreground="#C05BF1" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Player · AI · loài · cân nặng · zone" Foreground="#B7BDCA" FontSize="11" Margin="0,2,0,0" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="REALTIME" Foreground="#7689D7" FontFamily="Bahnschrift" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Rectangle Grid.Column="1" Fill="#353B55" />

                <Grid Grid.Column="2" Margin="25,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="ISLE LIVE MAP PRO" Foreground="{StaticResource Mint}" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="KEY PRO MIỄN PHÍ" Foreground="{StaticResource Gold}" FontFamily="Bahnschrift SemiCondensed" FontSize="38" FontWeight="Bold" Margin="-2,1,0,0" />
                        <TextBlock Text="Lấy key free, nhập một lần và mở toàn bộ công cụ Pro." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="Không phải hack: map chỉ hỗ trợ dữ liệu mục tiêu game đã gửi trong phạm vi render của bạn." Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,17,0,12" Background="#22102A" BorderBrush="#612F75" BorderThickness="1" Padding="12,9">
                        <TextBlock Text="KHÔNG CẦN MUA · LẤY KEY FREE TẠI TRANG CHÍNH THỨC" Foreground="#E2A0FF" FontFamily="Bahnschrift SemiCondensed" FontSize="10.5" FontWeight="Bold" TextAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Row="2">
                        <Grid Height="45"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Rectangle Fill="#FF4D57" RadiusX="1" RadiusY="1" Margin="0,7" /><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="PLAYER ĐƯỢC PHÂN LOẠI" Foreground="#F1E8F3" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="Ăn thịt · cùng loài · ăn cỏ, kèm loài và cân nặng." Foreground="#878E9E" FontSize="10.5" /></StackPanel></Grid>
                        <Rectangle Height="1" Fill="#262B3F" />
                        <Grid Height="45"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Rectangle Fill="#B33FF2" RadiusX="1" RadiusY="1" Margin="0,7" /><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="TÌM AI NHANH HƠN" Foreground="#F1E8F3" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="AI đã nhận diện hiển thị riêng để hỗ trợ quá trình nuôi." Foreground="#878E9E" FontSize="10.5" /></StackPanel></Grid>
                        <Rectangle Height="1" Fill="#262B3F" />
                        <Grid Height="45"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Rectangle Fill="#7689D7" RadiusX="1" RadiusY="1" Margin="0,7" /><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="FULL TẤT CẢ SERVER" Foreground="#F1E8F3" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="Không phụ thuộc website map hoặc plugin riêng của server." Foreground="#878E9E" FontSize="10.5" /></StackPanel></Grid>
                        <Rectangle Height="1" Fill="#262B3F" />
                        <Grid Height="45"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Rectangle Fill="#6EA9FF" RadiusX="1" RadiusY="1" Margin="0,7" /><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="TACTICAL MAP" Foreground="#F1E8F3" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="Zone, set point theo XYZ và chia sẻ mốc với đồng đội." Foreground="#878E9E" FontSize="10.5" /></StackPanel></Grid>
                        <Rectangle Height="1" Fill="#262B3F" />
                        <Grid Height="45"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Rectangle Fill="#D36DFF" RadiusX="1" RadiusY="1" Margin="0,7" /><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="LIVE SKIN · ALT + S" Foreground="#F1E8F3" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="Mở Skin Editor native theo dino IslePilot đang online." Foreground="#878E9E" FontSize="10.5" /></StackPanel></Grid>
                        <Rectangle Height="1" Fill="#262B3F" />
                        <Grid Height="45"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Rectangle Fill="#E5A45A" RadiusX="1" RadiusY="1" Margin="0,7" /><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="GARAGE · ALT + G" Foreground="#F1E8F3" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="Xem, park và restore dino trực tiếp trong overlay." Foreground="#878E9E" FontSize="10.5" /></StackPanel></Grid>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,17,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource QuietButton}" Content="ĐỂ SAU" Padding="6,10" Click="CloseButton_Click" AutomationProperties.Name="Đóng và xem sau" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="GetFreeKeyButton" Style="{StaticResource QuietButton}" Content="LẤY KEY FREE  ↗" Height="43" Padding="10,0" Margin="0,0,6,0" AutomationProperties.Name="Mở trang lấy key Pro miễn phí" Click="GetFreeKeyButton_Click" />
                            <Button x:Name="ActivateProButton" Style="{StaticResource PrimaryButton}" Content="NHẬP KEY" Height="43" Padding="17,0" IsDefault="True" AutomationProperties.Name="Nhập key kích hoạt Pro" Click="ActivateProButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
