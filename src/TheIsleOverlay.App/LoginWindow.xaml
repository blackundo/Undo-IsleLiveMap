<Window x:Class="TheIsleOverlay.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Đăng nhập nguồn telemetry" Width="1060" Height="760" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#070817" Foreground="#E9EFF4"
        FontFamily="Segoe UI Variable Text" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <Border BorderBrush="#353B55" BorderThickness="0,0,0,1" Background="#0B0D20">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SourceTitleLabel" Text="KẾT NỐI NGUỒN" FontFamily="Bahnschrift SemiCondensed" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="HostLabel" Foreground="#6E768D" FontFamily="Bahnschrift" FontSize="9" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="PHIÊN RIÊNG CỦA ISLE LIVE MAP" Foreground="#3745D4" FontFamily="Bahnschrift SemiCondensed" FontSize="9" HorizontalAlignment="Right" />
                    <TextBlock x:Name="CookieScopeLabel" Foreground="#636B80" FontSize="9" Margin="0,2,0,0" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="12" BorderBrush="#353B55" BorderThickness="1" Background="#0A0B1A">
            <Grid>
                <wv2:WebView2 x:Name="LoginBrowser" />
                <Border x:Name="BrowserLoadingPanel" Background="#F2070817">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="24" Height="24" Stroke="#3745D4" StrokeThickness="2" />
                        <TextBlock Text="ĐANG MỞ TRANG ĐĂNG NHẬP…" Foreground="#8D94A6" FontFamily="Bahnschrift SemiCondensed" FontSize="10" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="#353B55" BorderThickness="0,1,0,0" Background="#0B0D20">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="LoginStatusLabel" Text="Nếu chưa đăng nhập, hoàn tất trên website rồi bấm KIỂM TRA PHIÊN." Foreground="#787F93" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="KIỂM TRA PHIÊN" Padding="14,7" Margin="10,0,0,0" Click="CheckSessionButton_Click"
                        Background="#171C3F" Foreground="#E9EFF4" BorderBrush="#4F5981" FontFamily="Bahnschrift SemiCondensed" Cursor="Hand" />
                <Button Grid.Column="2" Content="ĐÓNG" Padding="14,7" Margin="8,0,0,0" Click="CloseButton_Click"
                        Background="Transparent" Foreground="#A8AEBB" BorderBrush="#484E65" FontFamily="Bahnschrift SemiCondensed" Cursor="Hand" />
            </Grid>
        </Border>
    </Grid>
</Window>
