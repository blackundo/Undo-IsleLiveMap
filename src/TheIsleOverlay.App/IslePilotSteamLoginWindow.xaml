<Window x:Class="TheIsleOverlay.App.IslePilotSteamLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Đăng nhập Steam · IslePilot" Width="1060" Height="760"
        MinWidth="820" MinHeight="620" WindowStartupLocation="CenterOwner"
        Background="#070817" Foreground="#E9EFF4"
        FontFamily="Segoe UI Variable Text"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="62" />
        </Grid.RowDefinitions>

        <Border Background="#0B0D20" BorderBrush="#353B55" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ĐĂNG NHẬP STEAM MỘT LẦN"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Tự nhận server IslePilot đang chơi"
                               Foreground="#787F93" FontSize="10.5" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="TELEMETRY + LIVE SKIN" Foreground="#3745D4"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="10"
                               FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="/me · /map · /skin" Foreground="#636B80"
                               FontFamily="Bahnschrift" FontSize="9" Margin="0,3,0,0"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="12" Background="#0A0B1A"
                BorderBrush="#353B55" BorderThickness="1">
            <Grid>
                <wv2:WebView2 x:Name="LoginBrowser" />
                <Border x:Name="BrowserLoadingPanel" Background="#F2070817">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="24" Height="24" Stroke="#3745D4" StrokeThickness="2" />
                        <TextBlock Text="ĐANG MỞ ĐĂNG NHẬP STEAM…"
                                   Foreground="#8D94A6" FontFamily="Bahnschrift SemiCondensed"
                                   FontSize="10" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#0B0D20" BorderBrush="#353B55" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LoginStatusLabel"
                           Text="Đăng nhập Steam một lần. Token Live Skin chỉ được lưu mã hóa cho tài khoản Windows hiện tại."
                           Foreground="#787F93" FontSize="10.5" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="THỬ LẠI" Padding="15,7" Margin="10,0,0,0"
                        Click="RetryButton_Click" Background="#171C3F" Foreground="#E9EFF4"
                        BorderBrush="#4F5981" FontFamily="Bahnschrift SemiCondensed" Cursor="Hand" />
                <Button x:Name="LocalOnlyButton" Grid.Column="2" Content="CHỈ MAP · KHÔNG STATS"
                        Visibility="Collapsed" Padding="15,7" Margin="8,0,0,0"
                        ToolTip="Chỉ dùng GPS và Pro tracking, không có dino stats hoặc nhiệm vụ IslePilot."
                        AutomationProperties.Name="Mở map không có stats IslePilot"
                        Click="LocalOnlyButton_Click" Background="Transparent" Foreground="#A8AEBB"
                        BorderBrush="#484E65" FontFamily="Bahnschrift SemiCondensed" Cursor="Hand" />
                <Button Grid.Column="3" Content="HỦY" Padding="15,7" Margin="8,0,0,0"
                        Click="CancelButton_Click" Background="Transparent" Foreground="#A8AEBB"
                        BorderBrush="#484E65" FontFamily="Bahnschrift SemiCondensed" Cursor="Hand" />
            </Grid>
        </Border>
    </Grid>
</Window>
