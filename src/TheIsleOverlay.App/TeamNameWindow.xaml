<Window x:Class="TheIsleOverlay.App.TeamNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tên thành viên" Width="430" Height="270"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="#D7DFE3" />
            <Setter Property="Background" Value="#172321" />
            <Setter Property="BorderBrush" Value="#40534F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#22322F" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#819B94" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#CFDAFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Foreground" Value="#F4F7F6" />
            <Setter Property="Background" Value="#355A52" />
            <Setter Property="BorderBrush" Value="#73A99A" />
        </Style>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="#96A5A1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#293936" />
                                <Setter Property="Foreground" Value="#F4F7F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogSurface" Margin="7" Background="#FF0D1918"
            BorderBrush="#536E68" BorderThickness="1" CornerRadius="11">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.42" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Background="#111F1D" BorderBrush="#304641"
                    BorderThickness="0,0,0,1" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,9,0">
                    <TextBlock Text="NHÓM SINH TỒN" Foreground="#7FA99D" FontSize="10"
                               FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Content="×" Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                            AutomationProperties.Name="Đóng hộp nhập tên" IsCancel="True" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,17,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="ActionTitle" Foreground="#EEF3F2" FontSize="19"
                               FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Tên này sẽ hiển thị với các thành viên trong phòng."
                               Foreground="#8E9D99" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="TÊN CỦA BẠN" Foreground="#A6B5B1" FontSize="10.5"
                           FontWeight="Bold" Margin="0,15,0,6" />

                <Border Grid.Row="2" Height="42" Background="#091211" BorderBrush="#59726C"
                        BorderThickness="1" CornerRadius="7">
                    <TextBox x:Name="NameInput" MaxLength="32" Padding="13,0"
                             Background="Transparent" Foreground="#F2F6F5" BorderThickness="0"
                             FontSize="14" VerticalContentAlignment="Center" CaretBrush="#D8E4E1"
                             SelectionBrush="#456B62" TextChanged="NameInput_TextChanged"
                             AutomationProperties.Name="Tên hiển thị trong phòng" />
                </Border>

                <Grid Grid.Row="3" Margin="0,17,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ValidationLabel" Text="Vui lòng nhập tên."
                               Foreground="#E58D80" FontSize="11" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                    <Button Grid.Column="1" Content="HỦY" Style="{StaticResource DialogButton}"
                            Margin="0,0,10,0" IsCancel="True" AutomationProperties.Name="Hủy" />
                    <Button x:Name="ConfirmButton" Grid.Column="2" Content="XÁC NHẬN"
                            Style="{StaticResource PrimaryDialogButton}" MinWidth="116"
                            IsDefault="True" IsEnabled="False" Click="ConfirmButton_Click"
                            AutomationProperties.Name="Xác nhận tên thành viên" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
